<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#253117"
    tools:context=".Pena_SectionFolder.SectionTemplate">


    <View
        android:id="@+id/viewBoxColorGreenTop"
        android:layout_width="408dp"
        android:layout_height="189dp"
        android:background="#546c4c"
        android:translationZ="2dp"
        app:layout_constraintBottom_toBottomOf="@id/currentCategoryHolder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <View
        android:id="@+id/viewBoxColorGreenInsideTop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/_4sdp"
        android:background="#6E8966"
        android:translationZ="2dp"
        app:layout_constraintBottom_toBottomOf="@id/viewBoxColorGreenTop"
        app:layout_constraintEnd_toEndOf="@id/viewBoxColorGreenTop"
        app:layout_constraintStart_toStartOf="@id/viewBoxColorGreenTop"
        app:layout_constraintTop_toTopOf="@id/viewBoxColorGreenTop" />


    <Button
        android:id="@+id/exit"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_35sdp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#576D54"
        android:text="X"
        android:translationZ="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:translationZ="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/gradingmadeeasylogo" />


    <TextView
        android:id="@+id/quarterOrSemesterHolder"
        android:layout_width="@dimen/_85sdp"
        android:layout_height="@dimen/_18sdp"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_bg"
        android:backgroundTint="#546c4c"
        android:text="Quarters"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:translationZ="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <HorizontalScrollView
        android:id="@+id/currentQuarterOrSemestersScroll"
        android:layout_width="0dp"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginStart="@dimen/_30sdp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/_30sdp"
        android:background="@drawable/rounded_bg"
        android:backgroundTint="#1e271b"
        android:translationZ="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quarterOrSemesterHolder">

        <LinearLayout
            android:id="@+id/linearLayoutForQuarters"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <Button
                android:id="@+id/RemoveQuarter"
                android:layout_width="@dimen/_48sdp"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:backgroundTint="#576D54"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="-" />

            <Button
                android:id="@+id/quarter1Button"
                android:layout_width="@dimen/_48sdp"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:backgroundTint="#576D54"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="1" />

            <Button
                android:id="@+id/addQuarter"
                android:layout_width="@dimen/_48sdp"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:backgroundTint="#576D54"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="+" />

        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/categoryNameView"
        android:layout_width="@dimen/_85sdp"
        android:layout_height="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/rounded_bg"
        android:backgroundTint="#546c4c"
        android:text="Categories"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:translationZ="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/currentQuarterOrSemestersScroll" />

    <HorizontalScrollView
        android:id="@+id/currentCategoryHolder"
        android:layout_width="0dp"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginStart="@dimen/_30sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginEnd="@dimen/_30sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:background="@drawable/rounded_bg"
        android:backgroundTint="#1e271b"
        android:translationZ="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/categoryNameView">

        <LinearLayout
            android:id="@+id/linearLayoutForCategories"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <Button
                android:id="@+id/removeCategory"
                android:layout_width="@dimen/_48sdp"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:backgroundTint="#576D54"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="-" />

            <Button
                android:id="@+id/currentCategory"
                android:layout_width="@dimen/_80sdp"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:backgroundTint="#576D54"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="2dp"
                android:text="Performance Task"
                app:autoSizeMaxTextSize="@dimen/_10ssp"
                app:autoSizeMinTextSize="@dimen/_3sdp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <Button
                android:id="@+id/finalGradeButton"
                android:layout_width="@dimen/_50sdp"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:backgroundTint="#576D54"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="2dp"
                android:text="Grades"
                app:autoSizeMaxTextSize="@dimen/_10ssp"
                app:autoSizeMinTextSize="@dimen/_3sdp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <Button
                android:id="@+id/addCategory"
                android:layout_width="@dimen/_48sdp"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:backgroundTint="#576D54"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="+" />

        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:id="@+id/scrollViewOfStudents"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_4sdp"
        android:background="#324321"
        app:layout_constraintBottom_toTopOf="@id/viewBoxColorGreenBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewBoxColorGreenTop">

        <LinearLayout
            android:id="@+id/layoutForListOfStudents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#324321"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_12sdp">

            <TextView
                android:id="@+id/WorkholderTextIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="STUDENT WORKS"
                android:textAlignment="center"
                android:textColor="@color/white" />

            <HorizontalScrollView
                android:id="@+id/WorkHolderScroll"
                android:layout_width="@dimen/_250sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/rounded_bg"
                android:backgroundTint="#1e271b"
                android:translationZ="5dp">

                <LinearLayout
                    android:id="@+id/linearLayoutForWorkholder"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/RemoveWork"
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="match_parent"
                        android:layout_margin="1dp"
                        android:layout_weight="1"
                        android:backgroundTint="#576D54"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="-" />

                    <Button
                        android:id="@+id/work1"
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="match_parent"
                        android:layout_margin="1dp"
                        android:backgroundTint="#576D54"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="1" />

                    <Button
                        android:id="@+id/addWork"
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="match_parent"
                        android:layout_margin="1dp"
                        android:backgroundTint="#576D54"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="+" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/borderForStudentListTextHolder_STUDENT"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_36sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/rounded_bg"
                android:backgroundTint="#546c4c"
                android:gravity="center"
                android:text="STUDENT            SCORE"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/StudentInformation"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_45sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/studentNameInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.3"
                    android:background="@drawable/rounded_bg"
                    android:backgroundTint="#1e271b"
                    android:hint="Student name"
                    android:inputType="text"
                    android:padding="8dp"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA" />

                <EditText
                    android:id="@+id/studentScoreInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_bg"
                    android:backgroundTint="#1e271b"
                    android:hint="Student Score"
                    android:inputType="numberDecimal"
                    android:padding="8dp"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA" />

            </LinearLayout>

            <Button
                android:id="@+id/addStudentInformation"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_38sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:backgroundTint="#576D54"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="+" />

            <Button
                android:id="@+id/removeStudentInformation"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_38sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:backgroundTint="#576D54"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="-" />

        </LinearLayout>
    </ScrollView>


    <View
        android:id="@+id/viewBoxColorGreenBottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#546c4c"
        android:translationZ="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/sectionInformationBottom_Section" />

    <View
        android:id="@+id/viewBoxColorGreenInsideBottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/_2sdp"
        android:background="#6E8966"
        android:translationZ="1dp"
        app:layout_constraintBottom_toBottomOf="@id/viewBoxColorGreenBottom"
        app:layout_constraintEnd_toEndOf="@id/viewBoxColorGreenBottom"
        app:layout_constraintStart_toStartOf="@id/viewBoxColorGreenBottom"
        app:layout_constraintTop_toTopOf="@id/viewBoxColorGreenBottom" />

    <TextView
        android:id="@+id/sectionInformation_GradingSystemInformation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/rounded_bg"
        android:backgroundTint="#839d7a"
        android:paddingHorizontal="@dimen/_6sdp"
        android:paddingVertical="@dimen/_2sdp"
        android:text="Grading System: Weighted Category"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:translationZ="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/finalizeGradeButton"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/sectionInformationBottom_Section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/rounded_bg"
        android:backgroundTint="#839d7a"
        android:paddingHorizontal="@dimen/_6sdp"
        android:paddingVertical="@dimen/_2sdp"
        android:text="Current Section: EXAMPLE SECTION"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:translationZ="5dp"
        app:layout_constraintBottom_toTopOf="@id/sectionInformation_GradingSystemInformation"
        app:layout_constraintEnd_toStartOf="@id/finalizeGradeButton"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/finalizeGradeButton"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:backgroundTint="#1e271b"
        android:elevation="@dimen/_7sdp"
        android:text="Update Grades"
        android:textSize="11sp"
        android:translationZ="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/sectionInformationBottom_Section" />

</androidx.constraintlayout.widget.ConstraintLayout>