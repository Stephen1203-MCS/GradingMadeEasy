<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SectionTemplate">

    <TextView
        android:id="@+id/quarterOrSemesterHolder"
        android:layout_width="@dimen/_85sdp"
        android:layout_height="@dimen/_15sdp"
        android:layout_marginStart="46dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="244dp"
        android:layout_marginBottom="854dp"
        android:layout_weight="1"
        android:background="@drawable/rounded_bg"
        android:backgroundTint="#546c4c"
        android:text="Quarters"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:translationZ="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <HorizontalScrollView
        android:id="@+id/currentQuarters"
        android:layout_width="@dimen/_146sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_marginStart="@dimen/_30sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginEnd="@dimen/_30sdp"
        android:layout_marginBottom="@dimen/_426sdp"
        android:background="@drawable/rounded_bg"
        android:backgroundTint="#1e271b"
        android:translationZ="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.078"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.036">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <Button
                android:id="@+id/quarter1Button"
                android:layout_width="@dimen/_48sdp"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:backgroundTint="#576D54"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="1" />

            <Button
                android:id="@+id/addCategory2"
                android:layout_width="@dimen/_52sdp"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:backgroundTint="#576D54"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="+" />
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:id="@+id/scrollViewOfStudents"
        android:layout_width="@dimen/_316sdp"
        android:layout_height="@dimen/_500sdp"
        android:layout_marginEnd="2dp"
        android:background="#f1ffec"
        app:layout_constraintBottom_toTopOf="@+id/viewBoxColorGreenBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewBoxColorGreenInsideTop"
        app:layout_constraintVertical_bias="0.472">

        <LinearLayout
            android:id="@+id/layoutForListOfStudents"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_300sdp"
            android:background="#324321"
            android:orientation="vertical">

            <HorizontalScrollView
                android:id="@+id/WorkHolderScroll"
                android:layout_width="@dimen/_270sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginStart="30dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="50dp"
                android:background="@drawable/rounded_bg"
                android:backgroundTint="#1e271b"
                android:translationZ="5dp">

                <LinearLayout
                    android:id="@+id/linearLayoutForWorkholder"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/work1"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="match_parent"
                        android:layout_margin="1dp"
                        android:backgroundTint="#576D54"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="1" />

                    <Button
                        android:id="@+id/overall"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_margin="1dp"
                        android:backgroundTint="#576D54"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="overall" />

                    <Button
                        android:id="@+id/addWork"
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="match_parent"
                        android:layout_margin="1dp"
                        android:backgroundTint="#576D54"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="+" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/WorkholderTextIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="STUDENT WORKS"
                android:textAlignment="center"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/borderForStudentListTextHolder_STUDENT"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_36sdp"
                android:layout_weight="1"
                android:background="@drawable/rounded_bg"
                android:backgroundTint="#546c4c"
                android:text="STUDENT            SCORE"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="30dp" />

            <LinearLayout
                android:id="@+id/StudentInformation"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_50ssp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/studentNameInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.3"
                    android:background="@drawable/rounded_bg"
                    android:backgroundTint="#1e271b"
                    android:hint="Student name"
                    android:inputType="text"
                    android:padding="8dp"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA" />

                <EditText
                    android:id="@+id/studentScoreInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/rounded_bg"
                    android:backgroundTint="#1e271b"
                    android:hint="Student Score"
                    android:inputType="numberDecimal"
                    android:padding="8dp"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA" />

            </LinearLayout>

            <Button
                android:id="@+id/addStudentInformation"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:backgroundTint="#576D54"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="+" />


        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/viewBoxColorGreenTop"
        android:layout_width="@dimen/_320sdp"
        android:layout_height="@dimen/_130sdp"
        android:layout_marginBottom="419dp"
        android:background="#546c4c"
        android:translationZ="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <View
        android:id="@+id/viewBoxColorGreenBottom"
        android:layout_width="@dimen/_3sdp"
        android:layout_height="@dimen/_52sdp"
        android:background="#546c4c"
        android:translationZ="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <View
        android:id="@+id/viewBoxColorGreenInsideBottom"
        android:layout_width="@dimen/_305sdp"
        android:layout_height="@dimen/_40sdp"
        android:background="#6E8966"
        android:translationZ="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.444"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.991" />


    <View
        android:id="@+id/viewBoxColorGreenInsideTop"
        android:layout_width="@dimen/_305sdp"
        android:layout_height="@dimen/_115sdp"
        android:background="#6E8966"
        android:translationZ="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.333"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.011" />

    <TextView
        android:id="@+id/sectionInformation_GradingSystemInformation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="485dp"
        android:layout_marginEnd="171dp"
        android:layout_marginBottom="13dp"
        android:background="@drawable/rounded_bg"
        android:backgroundTint="#839d7a"
        android:text="Grading System: Weighted Category"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:translationZ="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.307"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.992" />

    <TextView
        android:id="@+id/sectionInformationBottom_Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="467dp"
        android:layout_marginEnd="170dp"
        android:layout_marginBottom="31dp"
        android:background="@drawable/rounded_bg"
        android:backgroundTint="#839d7a"
        android:text="Current Section: St. Isidore of Seville"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:translationZ="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.307"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.992" />

    <Button
        android:id="@+id/button"
        android:layout_width="138dp"
        android:layout_height="48dp"
        android:layout_marginStart="274dp"
        android:layout_marginTop="466dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="6dp"
        android:backgroundTint="#1e271b"
        android:text="Update Grades"
        android:textSize="11sp"
        android:translationZ="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.986" />

    <HorizontalScrollView
        android:id="@+id/currentCategoryHolder"
        android:layout_width="@dimen/_250sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="68dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="426dp"
        android:background="@drawable/rounded_bg"
        android:backgroundTint="#1e271b"
        android:translationZ="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.013">

        <LinearLayout
            android:id="@+id/linearLayoutForCategories"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <Button
                android:id="@+id/currentCategory"
                android:layout_width="@dimen/_50sdp"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:backgroundTint="#576D54"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="ICT" />

            <Button
                android:id="@+id/addCategory"
                android:layout_width="@dimen/_48sdp"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:backgroundTint="#576D54"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="+" />

        </LinearLayout>
    </HorizontalScrollView>

    <Button
        android:id="@+id/exit"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_35sdp"
        android:backgroundTint="#576D54"
        android:text="X"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="@dimen/_48sdp"
        android:layout_height="@dimen/_48sdp"
        android:translationZ="2dp"
        app:srcCompat="@drawable/GradingMadeEasyLogo"
        tools:layout_editor_absoluteX="330dp"
        tools:layout_editor_absoluteY="9dp" />


</androidx.constraintlayout.widget.ConstraintLayout>