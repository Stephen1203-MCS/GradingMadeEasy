<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4F7942">

    <TextView
        android:id="@+id/WelcomeText"
        android:layout_width="203dp"
        android:layout_height="24dp"
        android:text="Welcome to GradingMadeEasy!"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        tools:layout_editor_absoluteX="102dp"
        tools:layout_editor_absoluteY="225dp" />

    <EditText
        android:id="@+id/UsernamePassword"
        android:layout_width="310dp"
        android:layout_height="43dp"
        android:backgroundTint="#161414"
        android:text="Password"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        tools:layout_editor_absoluteX="51dp"
        tools:layout_editor_absoluteY="406dp" />

    <EditText
        android:id="@+id/UsernamePassword"
        android:layout_width="306dp"
        android:layout_height="48dp"
        android:backgroundTint="#161414"
        android:text="Username"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        tools:layout_editor_absoluteX="53dp"
        tools:layout_editor_absoluteY="331dp" />

    <ImageView
        android:id="@+id/ImageView"
        android:layout_width="153dp"
        android:layout_height="115dp"
        android:layout_marginStart="128dp"
        android:layout_marginTop="92dp"
        android:translationZ="@dimen/_2sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/gradingmadeeasylogo" />

    <Button
        android:id="@+id/main"
        android:layout_width="336dp"
        android:layout_height="61dp"
        android:backgroundTint="#385E3F"
        android:text="Login"
        tools:layout_editor_absoluteX="37dp"
        tools:layout_editor_absoluteY="652dp" />


</androidx.constraintlayout.widget.ConstraintLayout>