<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4F7942">

    <TextView
        android:id="@+id/WelcomeText"
        android:layout_width="206dp"
        android:layout_height="25dp"
        android:text="Welcome to GradingMadeEasy!"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        tools:layout_editor_absoluteX="102dp"
        tools:layout_editor_absoluteY="225dp" />

    <EditText
        android:id="@+id/UsernamePassword"
        android:layout_width="202dp"
        android:layout_height="43dp"
        android:text="Password"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        tools:layout_editor_absoluteX="104dp"
        tools:layout_editor_absoluteY="342dp" />

    <ImageView
        android:id="@+id/AppIconSectionCreation"
        android:layout_width="137dp"
        android:layout_height="125dp"
        android:layout_marginStart="136dp"
        android:layout_marginTop="88dp"
        android:translationZ="@dimen/_2sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/GradingMadeEasyLogo" />

    <Button
        android:id="@+id/LoginButton"
        android:layout_width="336dp"
        android:layout_height="61dp"
        android:backgroundTint="#385E3F"
        android:text="Login"
        tools:layout_editor_absoluteX="37dp"
        tools:layout_editor_absoluteY="652dp" />


</androidx.constraintlayout.widget.ConstraintLayout>