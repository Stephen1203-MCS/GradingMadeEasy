<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#576D54"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/AppIconSectionCreation"
        android:layout_width="138dp"
        android:layout_height="113dp"
        android:translationZ="2dp"
        app:srcCompat="@drawable/GradingMadeEasyLogo"
        tools:layout_editor_absoluteX="257dp"
        tools:layout_editor_absoluteY="12dp" />

    <EditText
        android:id="@+id/sectionName"
        android:layout_width="378dp"
        android:layout_height="55dp"
        android:background="@drawable/rounded_bg"
        android:backgroundTint="#1e271b"
        android:text="Put your section name"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:translationZ="2dp"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="206dp" />

    <TextView
        android:id="@+id/sectionDetailsHeader"
        android:layout_width="335dp"
        android:layout_height="24dp"
        android:background="@drawable/evenmorerounded_bg"
        android:backgroundTint="#1e271b"
        android:text="Section Name:"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:translationZ="2dp"
        tools:layout_editor_absoluteX="35dp"
        tools:layout_editor_absoluteY="182dp" />

    <View
        android:id="@+id/viewContainterForSectionCreationAndChoosingOfGradingSystem"
        android:layout_width="379dp"
        android:layout_height="835dp"
        android:background="@drawable/evenmorerounded_bg"
        android:backgroundTint="#7F8A77"
        tools:layout_editor_absoluteX="15dp"
        tools:layout_editor_absoluteY="16dp" />

    <TextView
        android:id="@+id/textForGradingSystems"
        android:layout_width="222dp"
        android:layout_height="33dp"
        android:background="@drawable/evenmorerounded_bg"
        android:backgroundTint="#1e271b"
        android:text="Grading Systems"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="25dp"
        android:translationZ="2dp"
        tools:layout_editor_absoluteX="94dp"
        tools:layout_editor_absoluteY="296dp" />

    <TextView
        android:id="@+id/formulaShownForTheGradingSystem"
        android:layout_width="222dp"
        android:layout_height="33dp"
        android:background="@drawable/evenmorerounded_bg"
        android:backgroundTint="#1e271b"
        android:text="Formula Used"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="25dp"
        android:translationZ="2dp"
        tools:layout_editor_absoluteX="94dp"
        tools:layout_editor_absoluteY="571dp" />

    <TextView
        android:id="@+id/formulaTextBox"
        android:layout_width="313dp"
        android:layout_height="112dp"
        android:background="@drawable/evenmorerounded_bg"
        android:backgroundTint="#1e271b"
        android:text="Example Formula = TotalPoints / Student Scores etc. etc."
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="25dp"
        android:translationZ="2dp"
        tools:layout_editor_absoluteX="48dp"
        tools:layout_editor_absoluteY="621dp" />

    <Button
        android:id="@+id/createSectionDetailsButton"
        android:layout_width="174dp"
        android:layout_height="99dp"
        android:backgroundTint="#374731"
        android:text="CREATE SECTION"
        android:textSize="30dp"
        tools:layout_editor_absoluteX="113dp"
        tools:layout_editor_absoluteY="453dp" />

    <RadioGroup
        android:id="@+id/radioGroupForGradingSystems"
        android:layout_width="332dp"
        android:layout_height="95dp"
        android:translationZ="1dp"
        tools:layout_editor_absoluteX="38dp"
        tools:layout_editor_absoluteY="343dp">

        <RadioButton
            android:id="@+id/radioButton_SumOfAllScores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:background="@drawable/evenmorerounded_bg"
            android:backgroundTint="#1e271b"
            android:text="Total Sum of Points"
            android:textColor="@color/white"
            android:textSize="20dp" />

        <RadioButton
            android:id="@+id/radioButton_WeightedCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/evenmorerounded_bg"
            android:backgroundTint="#1e271b"
            android:text="Weighted Category"
            android:textColor="@color/white"
            android:textSize="20dp" />
    </RadioGroup>

    <View
        android:id="@+id/bottomView"
        android:layout_width="375dp"
        android:layout_height="91dp"
        android:background="#1e271b"
        tools:layout_editor_absoluteX="15dp"
        tools:layout_editor_absoluteY="761dp" />

    <View
        android:id="@+id/bottomView2"
        android:layout_width="379dp"
        android:layout_height="109dp"
        android:background="#1e271b"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="16dp" />

    <Button
        android:id="@+id/exitButtonForSectionCreation"
        android:layout_width="81dp"
        android:layout_height="84dp"
        android:backgroundTint="#576D54"
        android:text="X"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>