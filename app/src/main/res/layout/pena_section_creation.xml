<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#546c4c">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/_20sdp">

            <View
                android:id="@+id/viewContainterForSectionCreationAndChoosingOfGradingSystem"
                android:layout_width="0dp"
                android:layout_height="@dimen/_75sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:background="@drawable/evenmorerounded_bg"
                android:backgroundTint="#2B352B"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/_305sdp" />

            <Button
                android:id="@+id/exitButtonForSectionCreation"
                android:layout_width="@dimen/_45sdp"
                android:layout_height="@dimen/_45sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:backgroundTint="#576D54"
                android:text="X"
                android:textSize="@dimen/_16ssp"
                app:layout_constraintBottom_toBottomOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem"
                app:layout_constraintStart_toStartOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem"
                app:layout_constraintTop_toTopOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:text="CREATE YOUR SECTION"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem"
                app:layout_constraintEnd_toStartOf="@id/ImageView"
                app:layout_constraintStart_toEndOf="@id/exitButtonForSectionCreation"
                app:layout_constraintTop_toTopOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem" />

            <ImageView
                android:id="@+id/ImageView"
                android:layout_width="@dimen/_55sdp"
                android:layout_height="@dimen/_55sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                app:layout_constraintBottom_toBottomOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem"
                app:layout_constraintEnd_toEndOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem"
                app:layout_constraintTop_toTopOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem"
                app:srcCompat="@drawable/gradingmadeeasylogo" />

            <View
                android:id="@+id/viewContainterForSectionCreationAndChoosingOfGradingSystem2"
                android:layout_width="0dp"
                android:layout_height="@dimen/_90sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/evenmorerounded_bg"
                android:backgroundTint="#2A352A"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem"
                app:layout_constraintWidth_max="@dimen/_305sdp" />

            <TextView
                android:id="@+id/sectionDetailsHeader"
                android:layout_width="@dimen/_139sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/evenmorerounded_bg"
                android:backgroundTint="#435243"
                android:gravity="center"
                android:text="Section Name:"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp"
                android:translationZ="@dimen/_2sdp"
                app:layout_constraintStart_toStartOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem2"
                app:layout_constraintTop_toTopOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem2" />

            <EditText
                android:id="@+id/sectionName"
                android:layout_width="0dp"
                android:layout_height="@dimen/_43sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:background="@drawable/evenmorerounded_bg"
                android:backgroundTint="#435243"
                android:paddingHorizontal="@dimen/_8sdp"
                android:text="Put your section name"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="@dimen/_18ssp"
                android:translationZ="@dimen/_2sdp"
                app:layout_constraintBottom_toBottomOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem2"
                app:layout_constraintEnd_toEndOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem2"
                app:layout_constraintStart_toStartOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem2"
                app:layout_constraintTop_toBottomOf="@id/sectionDetailsHeader" />

            <View
                android:id="@+id/viewContainterForSectionCreationAndChoosingOfGradingSystem3"
                android:layout_width="0dp"
                android:layout_height="@dimen/_165sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/evenmorerounded_bg"
                android:backgroundTint="#2B352B"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem2"
                app:layout_constraintWidth_max="@dimen/_305sdp" />

            <TextView
                android:id="@+id/textForGradingSystems"
                android:layout_width="@dimen/_173sdp"
                android:layout_height="@dimen/_26sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/evenmorerounded_bg"
                android:backgroundTint="#435243"
                android:gravity="center"
                android:text="Grading Systems"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="@dimen/_15ssp"
                android:translationZ="@dimen/_2sdp"
                app:layout_constraintStart_toStartOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem3"
                app:layout_constraintTop_toTopOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem3" />

            <RadioGroup
                android:id="@+id/radioGroupForGradingSystems"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:translationZ="@dimen/_1sdp"
                app:layout_constraintBottom_toBottomOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem3"
                app:layout_constraintEnd_toEndOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem3"
                app:layout_constraintStart_toStartOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem3"
                app:layout_constraintTop_toBottomOf="@id/textForGradingSystems">

                <RadioButton
                    android:id="@+id/radioButton_SumOfAllScores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_6sdp"
                    android:background="@drawable/evenmorerounded_bg"
                    android:backgroundTint="#435243"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:paddingVertical="@dimen/_6sdp"
                    android:text="Total Sum of Points"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_15ssp" />

                <RadioButton
                    android:id="@+id/radioButton_WeightedCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/evenmorerounded_bg"
                    android:backgroundTint="#435243"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:paddingVertical="@dimen/_6sdp"
                    android:text="Weighted Category"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_15ssp" />
            </RadioGroup>

            <View
                android:id="@+id/viewContainterForSectionCreationAndChoosingOfGradingSystem4"
                android:layout_width="0dp"
                android:layout_height="@dimen/_135sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/evenmorerounded_bg"
                android:backgroundTint="#2B352B"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem3"
                app:layout_constraintWidth_max="@dimen/_305sdp" />

            <TextView
                android:id="@+id/formulaShownForTheGradingSystem"
                android:layout_width="@dimen/_173sdp"
                android:layout_height="@dimen/_26sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:background="@drawable/evenmorerounded_bg"
                android:backgroundTint="#435243"
                android:gravity="center"
                android:text="Formula Used"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="@dimen/_15ssp"
                android:translationZ="@dimen/_2sdp"
                app:layout_constraintStart_toStartOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem4"
                app:layout_constraintTop_toTopOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem4" />

            <TextView
                android:id="@+id/formulaTextBox"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:background="@drawable/evenmorerounded_bg"
                android:backgroundTint="#435243"
                android:gravity="center"
                android:padding="@dimen/_8sdp"
                android:text="Example Formula = TotalPoints / Student Scores"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="@dimen/_15ssp"
                android:translationZ="@dimen/_2sdp"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="@dimen/_8ssp"
                app:autoSizeMaxTextSize="@dimen/_15ssp"
                app:autoSizeStepGranularity="1sp"
                app:layout_constraintBottom_toBottomOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem4"
                app:layout_constraintEnd_toEndOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem4"
                app:layout_constraintStart_toStartOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem4"
                app:layout_constraintTop_toBottomOf="@id/formulaShownForTheGradingSystem" />


            <View
                android:id="@+id/viewContainterForSectionCreationAndChoosingOfGradingSystem5"
                android:layout_width="0dp"
                android:layout_height="@dimen/_80sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/evenmorerounded_bg"
                android:backgroundTint="#2B352B"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem4"
                app:layout_constraintWidth_max="@dimen/_305sdp" />

            <Button
                android:id="@+id/createSectionDetailsButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/_60sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:backgroundTint="#374731"
                android:text="CREATE SECTION"
                android:textSize="@dimen/_20ssp"
                app:layout_constraintBottom_toBottomOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem5"
                app:layout_constraintEnd_toEndOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem5"
                app:layout_constraintStart_toStartOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem5"
                app:layout_constraintTop_toTopOf="@id/viewContainterForSectionCreationAndChoosingOfGradingSystem5" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>