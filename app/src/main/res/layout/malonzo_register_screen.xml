<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4F7942">

    <TextView
        android:id="@+id/WelcomeText"
        android:layout_width="203dp"
        android:layout_height="24dp"
        android:text="Welcome to GradingMadeEasy!"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        tools:layout_editor_absoluteX="102dp"
        tools:layout_editor_absoluteY="225dp" />

    <EditText
        android:id="@+id/UsernamePassword"
        android:layout_width="318dp"
        android:layout_height="47dp"
        android:backgroundTint="#161414"
        android:text="Password"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        tools:layout_editor_absoluteX="43dp"
        tools:layout_editor_absoluteY="406dp" />

    <EditText
        android:id="@+id/UsernamePassword"
        android:layout_width="314dp"
        android:layout_height="49dp"
        android:backgroundTint="#161414"
        android:text="Username"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        tools:layout_editor_absoluteX="43dp"
        tools:layout_editor_absoluteY="326dp" />

    <ImageView
        android:id="@+id/AppIconSectionCreation"
        android:layout_width="153dp"
        android:layout_height="115dp"
        android:layout_marginStart="128dp"
        android:layout_marginTop="92dp"
        android:translationZ="@dimen/_2sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/GradingMadeEasyLogo" />

    <Button
        android:id="@+id/LoginButton"
        android:layout_width="336dp"
        android:layout_height="61dp"
        android:backgroundTint="#385E3F"
        android:text="Register"
        tools:layout_editor_absoluteX="37dp"
        tools:layout_editor_absoluteY="652dp" />

    <Button
        android:id="@+id/LoginButton"
        android:layout_width="336dp"
        android:layout_height="61dp"
        android:backgroundTint="#385E3F"
        android:text="Login to another account"
        tools:layout_editor_absoluteX="37dp"
        tools:layout_editor_absoluteY="734dp" />


</androidx.constraintlayout.widget.ConstraintLayout>